generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  description String
  amount      Float
  type        String   // 'credit' or 'debit'
  category    String
  txHash      String
  blockNumber Int?
}

model Proposal {
  id          String   @id @default(cuid())
  title       String
  description String
  amount      Float
  category    String
  createdBy   String
  createdAt   DateTime @default(now())
  status      String   @default("active") // 'active', 'approved', 'rejected'
  votesFor    Int      @default(0)
  votesAgainst Int      @default(0)
  votes       Vote[]
}

model Vote {
  id         String   @id @default(cuid())
  memberId   String
  vote       String   // 'for' or 'against'
  txHash     String
  timestamp  DateTime @default(now())
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  proposalId String
}
